# FinSentinel — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── HuggingFace (optional — needed for private models or higher rate limits) ──
# HF_TOKEN=hf_your_token_here

# ── Newsdata.io API key (OPTIONAL — enables deep historical news backfill) ────
# The pipeline runs fine without this key using Yahoo RSS + SEC EDGAR.
# To enable historical enrichment (up to 1 year back):
#   1. Sign up at https://newsdata.io and subscribe to a paid plan
#   2. Uncomment the line below and paste your key
# NEWSDATA_API_KEY=pub_your_key_here

# ── SEC EDGAR User-Agent (required by EDGAR's fair-use policy) ────────────────
# Format: "FirstName LastName youremail@example.com"
SEC_EDGAR_USER_AGENT="Your Name youremail@example.com"

# ── Proxy (optional — for corporate networks) ─────────────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# ── Log Level Override (optional — overrides config.yaml) ─────────────────────
# LOG_LEVEL=DEBUG

# ── Data Directory Overrides (optional) ───────────────────────────────────────
# RAW_DATA_DIR=data/raw
# PROCESSED_DATA_DIR=data/processed
