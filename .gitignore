# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Raw Data (can be large; regenerate via scraper) ──────────────────────────
data/raw/
data/processed/

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/

# ── Distribution / Build ──────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Type Checking ──────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json

# ── Linting ───────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Model Cache (HuggingFace downloads — large) ──────────────────────────────
.cache/
models/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Keep empty dirs tracked
!.gitkeep
